#!/usr/bin/env bash
set -euo pipefail

# Check if nextflow is installed
if ! command -v nextflow &> /dev/null; then
    echo "Error: nextflow is not installed or not in PATH"
    echo "Please install nextflow from https://www.nextflow.io/"
    exit 1
fi

# Require Nextflow >= 26.04, which introduced the -files-from option this hook
# relies on to stream filenames via stdin (avoids the OS ARG_MAX limit).
required_major=26
required_minor=4
nf_version=$(nextflow -version 2>/dev/null | grep -oE 'version [0-9]+\.[0-9]+' | head -1 | grep -oE '[0-9]+\.[0-9]+' || true)
if [[ -z "$nf_version" ]]; then
    echo "Warning: could not determine Nextflow version; this hook requires Nextflow >= ${required_major}.$(printf '%02d' "$required_minor") for -files-from support"
else
    nf_major=${nf_version%%.*}
    nf_minor=${nf_version#*.}
    # 10# forces base-10 so leading zeros (e.g. 04) are not read as octal
    if (( 10#$nf_major < required_major || (10#$nf_major == required_major && 10#$nf_minor < required_minor) )); then
        echo "Error: Nextflow >= ${required_major}.$(printf '%02d' "$required_minor") is required (found ${nf_version}); the -files-from option was added in ${required_major}.$(printf '%02d' "$required_minor")"
        echo "Please upgrade Nextflow: https://www.nextflow.io/"
        exit 1
    fi
fi

# Separate nextflow lint flags from file arguments.
# pre-commit passes: [args...] [filenames...]
# Flags that take a value: -output/-o, -exclude, -spaces
args=()
files=()
expect_value=false
for arg in "$@"; do
    if $expect_value; then
        args+=("$arg")
        expect_value=false
    elif [[ "$arg" == -* && ${#files[@]} -eq 0 ]]; then
        args+=("$arg")
        # These flags require a following value argument
        case "$arg" in
            -output|-o|-exclude|-spaces) expect_value=true ;;
        esac
    else
        files+=("$arg")
    fi
done

# If no files were passed, nothing to lint
if [[ ${#files[@]} -eq 0 ]]; then
    echo "No Nextflow files found to lint"
    exit 0
fi

# Feed filenames to nextflow lint via stdin (-files-from -) so they never hit
# the OS "Argument list too long" (E2BIG) limit, no matter how many files
# pre-commit passes. This is a single JVM invocation regardless of file count.
# printf newline-delimits paths, so paths with spaces are safe.
# Requires Nextflow >= 26.04 (which introduced -files-from).
# Use ${args[@]+...} for bash 3.x compatibility (empty array + set -u).
if printf '%s\n' "${files[@]}" | nextflow lint ${args[@]+"${args[@]}"} -files-from -; then
    echo "✅ Nextflow lint passed (${#files[@]} files)"
else
    echo "❌ Nextflow lint failed"
    exit 1
fi